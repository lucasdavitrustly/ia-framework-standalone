    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "@ia-framework/retrieval": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.2",
    "typescript": "^5.9.0"
  }
}
