# ia-framework environment configuration
# Copy this file to .env and fill in your values
# .env is gitignored — never commit secrets

# Required: Path to the ia-framework .ia-framework/ directory
# Set automatically by install.sh — override here if needed
IA_FRAMEWORK_DIR=/path/to/ia-framework/.ia-framework

# Optional: Dashboard port (default: 3000)
DASHBOARD_PORT=3000

# Optional: Qdrant port bindings (defaults shown)
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# OpenAI embedding (if using cloud embeddings)
# OPENAI_API_KEY=sk-...

# Target project (can also be set in .ia-framework/project.json)
# TARGET_PROJECT_PATH=/path/to/your/project
